-- Spring Duels Hub 🌸 https://discord.gg/M8Yb2ntf6

-- Get necessary Roblox services
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Stats = game:GetService("Stats")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- Get player character
local Character = LocalPlayer.Character
if not Character then return end

-- Wait for HumanoidRootPart
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 5)
if not HumanoidRootPart then return end

-- Spin effect
local BodyAngularVelocity = Instance.new("BodyAngularVelocity")
BodyAngularVelocity.MaxTorque = Vector3.new(0, math.huge, 0)
BodyAngularVelocity.AngularVelocity = Vector3.new(0, 25, 0)
BodyAngularVelocity.Parent = HumanoidRootPart

-- Respawn handling
local Connection
Connection = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 5)
    if not newRoot then return end
    
    if BodyAngularVelocity then 
        BodyAngularVelocity:Destroy() 
    end
    
    BodyAngularVelocity = Instance.new("BodyAngularVelocity")
    BodyAngularVelocity.MaxTorque = Vector3.new(0, math.huge, 0)
    BodyAngularVelocity.AngularVelocity = Vector3.new(0, 25, 0)
    BodyAngularVelocity.Parent = newRoot
end)

-- Remove old GUI
local existingGui = CoreGui:FindFirstChild("Spring_Duels_Hub")
if existingGui then 
    existingGui:Destroy() 
end

