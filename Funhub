		char:ClearAllChildren()
		local fakeModel = Instance.new("Model")
		fakeModel.Parent = Workspace
		LocalPlayer.Character = fakeModel
		task.wait()
		LocalPlayer.Character = char
		fakeModel:Destroy()
	end
end
