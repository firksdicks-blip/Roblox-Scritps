local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

-- --- CONFIGURACIÃ“N DE COMANDOS ---
local allCommands = {"rocket", "ragdoll", "balloon", "inverse", "nightvision", "tiny", "jumpscare", "morph"}
local commandRemote = nil

local function findRemote()
    local path = ReplicatedStorage:FindFirstChild("Packages")
    local net = path and path:FindFirstChild("Net")
    commandRemote = net and net:FindFirstChild("RE/AdminPanelService/ExecuteCommand")
    return commandRemote
end

local function launchFinalAttack()
    if not commandRemote then findRemote() end
    if not commandRemote then return end
    
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= LocalPlayer then
            task.spawn(function()
                for _, cmd in ipairs(allCommands) do
                    pcall(function() 
                        commandRemote:FireServer(target, cmd) 
                    end)
                end
            end)
        end
    end
end

